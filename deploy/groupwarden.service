[Unit]
Description=groupwarden: anti-spam moderator for WhatsApp Communities
Documentation=https://github.com/hoiung/groupwarden/blob/main/docs/deploy.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=groupwarden
Group=groupwarden
ExecStart=/usr/local/bin/groupwarden run --config /var/lib/groupwarden/config/config.yaml
# The config sync sends SIGHUP itself; this lets `systemctl reload` do it too.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s
# 78 (`groupwarden fatal-exit-code`): WhatsApp needs a human (logged out,
# banned, client outdated). Restarting into that only hammers WhatsApp.
RestartPreventExitStatus=78
# A clean stop tells the admin chat before it exits.
TimeoutStopSec=60s
StateDirectory=groupwarden
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
