[Unit]
Description=groupwarden: record and report a nightly backup that failed before it said why
Documentation=https://github.com/hoiung/groupwarden/blob/main/docs/deploy.md

[Service]
Type=oneshot
User=groupwarden
Group=groupwarden
# Run by groupwarden-backup.service's OnFailure=. No write access to
# backup.target_dir: when systemd could not open it (a network share that
# cannot be reached), this unit must still start, record the failure in
# groupwarden.db and report it to the admins the same night.
ExecStart=/usr/local/bin/groupwarden backup-failed --config /var/lib/groupwarden/config/config.yaml
StateDirectory=groupwarden
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
